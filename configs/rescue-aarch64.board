include toolchain-aarch64-glibc.common
include rescue-board.common

# Target definition
BR2_aarch64=y
BR2_cortex_a53=y
BR2_TARGET_OPTIMIZATION="-pipe -fsigned-char"
BR2_ARM_FPU_NEON_FP_ARMV8=y
BR2_PACKAGE_RESCUE_TARGET_AARCH64=y
#BR2_TARGET_GENERIC_GETTY_PORT="tty1"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_RESCUE_PATH)/board/patches $(BR2_EXTERNAL_RESCUE_PATH)/board/aarch64/patches"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_RESCUE_PATH)/board/fsoverlay $(BR2_EXTERNAL_RESCUE_PATH)/board/aarch64/fsoverlay"
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y

# Linux headers: 4.19, set in toolchain-aarch64-glibc.common (glibc's
# minimum kernel follows them)
BR2_KERNEL=n

# One image for every aarch64 REG board, whatever the kernel page size: link
# with 64 KiB alignment (Buildroot passes -z max-page-size from this), which
# loads on 4K, 16K (Apple Silicon) and 64K kernels. Only the ELF layout
# changes; the page size is still read from the kernel at run time.
BR2_ARM64_PAGE_SIZE_64K=y

# Filesystem
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y

# spi flash support
BR2_PACKAGE_MTD=y
