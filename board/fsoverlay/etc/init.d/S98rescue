#!/bin/dash

case "$1" in
start)
    if [ -f /boot/REG_RESCUE ] || [ -f /tmp/REG_RESCUE ]; then
        mount -o remount,rw /boot
        rm -f /boot/REG_RESCUE /tmp/REG_RESCUE
        /usr/bin/plymouth --wait quit
        # Rebind the framebuffer console S002plymouth unbound, or the rescue shell below renders to nothing.
        for vtcon in /sys/class/vtconsole/vtcon*; do
            [ -r "$vtcon/name" ] || continue
            case "$(cat "$vtcon/name")" in
                *"frame buffer device"*) echo 1 > "$vtcon/bind" ;;
            esac
        done
    else
        shutdown -r now
    fi
    ;;
stop)
    if [ -f /tmp/REG_UPDATE ]; then
        /usr/bin/plymouth change-mode --reboot
    else
        /usr/bin/plymouth change-mode --shutdown
    fi
    /usr/bin/plymouth --show-splash
    ;;
*)
    exit 0
    ;;
esac
